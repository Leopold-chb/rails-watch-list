<div class="container mt-4 mb-5">
  <div class="lists-container">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
      <div>
        <h1 class="mb-2"><i class="fas fa-film"></i> Mes listes de films</h1>
        <p class="mb-0 opacity-75">Organisez vos films préférés en listes personnalisées</p>
      </div>
      <%= link_to new_list_path, class: "btn btn-light btn-lg mt-3 mt-md-0" do %>
        <i class="fas fa-plus"></i> Créer une nouvelle liste
      <% end %>
    </div>
  </div>

  <% if @lists.empty? %>
    <div class="empty-state">
      <i class="fas fa-inbox"></i>
      <h3 class="mt-3">Aucune liste pour le moment</h3>
      <p class="text-muted mb-4">Créez votre première liste pour commencer à organiser vos films préférés !</p>
      <%= link_to new_list_path, class: "btn btn-primary btn-lg" do %>
        <i class="fas fa-plus"></i> Créer ma première liste
      <% end %>
    </div>
  <% else %>
    <div class="row g-4">
      <% @lists.each do |list| %>
        <div class="col-md-4 col-sm-6">
          <div class="list-card card h-100 shadow-sm">
            <div class="card-body d-flex flex-column p-4">
              <div class="mb-3">
                <h4 class="card-title mb-2">
                  <i class="fas fa-list-ul text-primary me-2"></i>
                  <%= list.name %>
                </h4>
                <p class="card-text text-muted mb-0">
                  <i class="fas fa-film me-1"></i>
                  <%= pluralize(list.movies.count, 'film') %>
                </p>
              </div>
              <div class="mt-auto">
                <%= link_to list_path(list), class: "btn btn-primary w-100" do %>
                  <i class="fas fa-eye me-2"></i>Voir la liste
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
