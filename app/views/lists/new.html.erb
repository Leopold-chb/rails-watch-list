<div class="container mt-4 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="lists-container mb-4">
        <h1 class="mb-2"><i class="fas fa-plus-circle"></i> Créer une nouvelle liste</h1>
        <p class="mb-0 opacity-75">Donnez un nom à votre nouvelle liste de films</p>
      </div>

      <div class="form-card">
        <%= simple_form_for @list do |f| %>
          <div class="mb-4">
            <%= f.input :name, label: "Nom de la liste", placeholder: "Ex: Drama, Comedy, Classic, To rewatch...", input_html: { class: "form-control form-control-lg" } %>
            <small class="form-text text-muted">
              <i class="fas fa-lightbulb me-1"></i>
              Choisissez un nom unique et descriptif pour votre liste
            </small>
          </div>

          <div class="d-flex gap-3">
            <%= f.submit "Créer la liste", class: "btn btn-primary btn-lg flex-grow-1" %>
            <%= link_to lists_path, class: "btn btn-outline-secondary btn-lg" do %>
              <i class="fas fa-times me-2"></i>Annuler
            <% end %>
          </div>

          <% if @list.errors.any? %>
            <div class="alert alert-danger mt-4">
              <i class="fas fa-exclamation-triangle me-2"></i>
              <strong>Erreurs :</strong>
              <ul class="mb-0 mt-2">
                <% @list.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
